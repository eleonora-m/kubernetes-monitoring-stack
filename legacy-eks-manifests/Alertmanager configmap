apiVersion: v1
kind: ConfigMap
metadata:
  name: alertmanager-config
  namespace: monitoring
data:
  alertmanager.yml: |
    global:
      resolve_timeout: 5m

    route:
      group_by: ['alertname', 'severity']
      group_wait: 30s
      group_interval: 5m
      repeat_interval: 4h
      receiver: 'email-notifications'
      routes:
        - match:
            severity: critical
          receiver: 'email-notifications'
          repeat_interval: 1h

    receivers:
      - name: 'email-notifications'
        email_configs:
          - to: 'devops.nora@gmail.com'
            from: 'alertmanager@monitoring.local'
            smarthost: 'smtp.gmail.com:587'
            auth_username: 'devops.nora@gmail.com'
            auth_password: 'YOUR_APP_PASSWORD'
            send_resolved: true

    inhibit_rules:
      - source_match:
          severity: 'critical'
        target_match:
          severity: 'warning'
        equal: ['alertname', 'instance']
