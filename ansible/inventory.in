[master-node]
# Replace with your actual server IP
master-server-01 ansible_host=192.168.1.10 ansible_user=ubuntu

[worker-nodes]
worker-server-01 ansible_host=192.168.1.11 ansible_user=ubuntu
worker-server-02 ansible_host=192.168.1.12 ansible_user=ubuntu

[all:vars]
ansible_python_interpreter=/usr/bin/python3